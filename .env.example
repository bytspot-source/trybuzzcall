PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
BUSINESS_CITY=              # shop city/area, e.g. "Atlanta, GA" (used only to phrase texts)
BUSINESS_NAME=Peach State Plumbing
# Business type (src/trades.js). When set it wins over VERTICAL/BUSINESS_VERTICAL. Appointment trades: braiders nails
# lashes_brows barber hair_salon makeup esthetician massage pet_grooming tutoring photography. Job trades: plumbing hvac
# electrical handyman cleaning landscaping mobile_detailing catering_bakery. other = set BUSINESS_FLOW + BUSINESS_TRADE_LABEL.
BUSINESS_TYPE=
BUSINESS_FLOW=              # other only: appointments (pick a service + time) | jobs (describe the job)
BUSINESS_TRADE_LABEL=       # other only: e.g. "Pool cleaning"
# Legacy niche (still works when BUSINESS_TYPE is empty): home_services (default; plumber/HVAC) | braiders
VERTICAL=home_services
BUSINESS_VERTICAL=plumber   # home_services only: plumber | hvac
# --- braiders only (VERTICAL=braiders) ---
# Service menu "Name:minutes,..." - caller picks one, then gets 3 start times that fit that length in BUSINESS_HOURS
SERVICES=Knotless braids:360,Box braids:300,Locs retwist:120,Twists:180
SLOT_STEP_MINUTES=60       # spacing between offered start times (braiders)
BOOKING_LINK=              # optional: stylist's own Booksy/StyleSeat/GlossGenius link, offered in the texts
# For braiders, unset BUSINESS_HOURS/BUSINESS_DAYS/DEPOSIT_AMOUNT/LEAD_FEE to get defaults 09:00-19:00, Mon-Sat (1-6), $50, $5
OWNER_PHONE=+14045550100
# Twilio (leave blank for demo/log mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Number the Twilio line forwards to (owner's real phone); empty = treat every call as missed
FORWARD_TO_PHONE=
RING_TIMEOUT_SECONDS=20
# AI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Stripe (optional; without STRIPE_SECRET_KEY deposits use a local mock link /pay/mock/:id). Platform key: test mode first
# (sk_test_... or a restricted rk_test_... key with Connect accounts + account links + Checkout Sessions write access).
STRIPE_SECRET_KEY=
# Shop subscription billing (src/billing.js). Without STRIPE_SECRET_KEY everything runs in MOCK mode (/billing/mock/*).
# POST /api/checkout {plan: monthly|annual} -> Stripe Checkout mode=subscription, card required, free trial.
STRIPE_PRICE_ID_BASE_MONTHLY=   # recurring monthly Price (e.g. $49/mo)
STRIPE_PRICE_ID_BASE_ANNUAL=    # recurring yearly Price
STRIPE_PRICE_ID_SETUP=          # optional one-time setup Price (~$99); monthly only. Never charged at signup: added as a pending
                                # InvoiceItem on checkout.session.completed so it lands on the first invoice after the trial
FOUNDING_SHOPS_LIMIT=10         # first N shops in the store get the setup fee waived (trial-cancelled shops free their slot)
SETUP_FEE_WAIVED=0              # 1 = waive setup for this deploy's shop(s)
SETUP_WAIVER_CODE=              # optional code: POST /api/checkout {setup_waiver_code} waives setup for that signup
SETUP_FEE_DISPLAY=99            # amount shown in Checkout text / owner reminders (live charge = your Stripe setup Price)
TRIAL_DAYS=14                   # free trial on signup; 0 = no trial. Trial converts automatically unless cancelled
ANNUAL_UPGRADE_PRORATION=always_invoice      # monthly->annual: invoice the prorated difference now
MONTHLY_DOWNGRADE_PRORATION=create_prorations # annual->monthly: unused annual time becomes account credit
BILLING_PORTAL_RETURN_URL=      # where the Stripe Billing Portal returns to; default {PUBLIC_BASE_URL}/
# What happens when the subscription lapses (past_due / canceled / unpaid):
BILLING_ENFORCE=1               # 0 = never limit service for billing reasons
BILLING_REQUIRE_SUBSCRIPTION=0  # 1 = no subscription on file also counts as inactive (0 keeps manual pilots working)
PAST_DUE_GRACE_DAYS=0           # keep full service this many days after a failed payment
INACTIVE_MODE=generic           # generic = caller gets one polite "please call back" text per 24h, no booking/deposit; silent = no text
INACTIVE_MESSAGE=               # optional custom text for generic mode (include "Reply STOP to opt out.")
# Mock-mode demo amounts only (live amounts come from your Stripe Prices)
MOCK_PRICE_MONTHLY=49
MOCK_PRICE_ANNUAL=588
MOCK_SETUP_FEE=99
# Per-paid-lead fee: charged to the shop only when a caller books AND pays the deposit
LEAD_FEE=12                     # USD per paid lead (default 12; braiders default 5)
LEAD_FEE_WAIVED=1               # default ON (pilot): fee recorded as 'waived', nothing charged. 0 = take it as a Stripe
                                # application fee on the deposit, capped at deposit-1c and at 1/3 of the deposit
# Stripe Connect (deposits go to the SHOP OWNER's own Stripe account, never BuzzCall's): direct charges. The deposit
# Checkout Session is created on the shop's connected account (Stripe-Account header). Onboard from /admin
# ("Connect Stripe to receive deposits"); the account id + status are stored per shop in the config override (Postgres).
# FAIL CLOSED: with STRIPE_SECRET_KEY set but no connected account with charges_enabled, no deposit is requested;
# callers are booked without a deposit and the owner alert says "deposit off: Stripe not connected".
# Without STRIPE_SECRET_KEY everything is mock: onboarding is simulated (/admin/connect/mock) and deposits use /pay/mock/:id.
STRIPE_CONNECT_ACCOUNT_ID=      # optional, backward-compatible fallback for the account id only (acct_...); status is read from Stripe
# Connect webhook: endpoint {PUBLIC_BASE_URL}/stripe/connect/webhook, scope "Connected accounts". Events:
# checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# account.updated, account.application.deauthorized. Its own signing secret (whsec_...); required when Stripe is on.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Booking + deposit (optional; both off = classic name -> need -> callback flow)
BOOKING_ENABLED=1          # offer 3 next open slots after the "need" step; caller replies 1/2/3 or "callback"
BUSINESS_TZ=America/New_York
BUSINESS_HOURS=08:00-17:00 # HH:MM-HH:MM, local to BUSINESS_TZ (default 08:00-17:00; braiders 09:00-19:00)
BUSINESS_DAYS=1,2,3,4,5    # 0=Sun ... 6=Sat (default 1-5; braiders 1,2,3,4,5,6)
SLOT_MINUTES=120           # home_services appointment block length
BOOKING_LEAD_MINUTES=60    # earliest slot must start at least this far from now
DEPOSIT_ENABLED=1          # require a deposit to confirm; off = slot booked immediately
DEPOSIT_AMOUNT=49          # USD (default 49; braiders 50, credited toward the service)
HOLD_MINUTES=30            # unpaid holds expire after this (slot is released)
# Stripe platform webhook: endpoint {PUBLIC_BASE_URL}/stripe/webhook (scope "Your account"). Events: checkout.session.completed (signups),
# customer.subscription.created/updated/deleted, customer.subscription.trial_will_end, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# Admin (also protects /billing/portal, /billing/status, /api/billing/*)
ADMIN_PASSWORD=change-me       # use a long random value in production
ADMIN_USERNAME=                # optional; empty = any username is accepted (only the password is checked)
ADMIN_MAX_FAILS=10             # wrong passwords per client IP before a lockout (429)
ADMIN_LOCKOUT_MINUTES=15       # lockout / counting window
ADMIN_GLOBAL_MAX_FAILS=100     # wrong passwords from ALL clients per window; past it admin requests are slowed (not blocked)
ADMIN_GLOBAL_DELAY_MS=3000     # delay per admin request while over the global cap; the owner gets one alert per window
ADMIN_PASSWORD_STRICT=         # 1 = refuse to start in production with a weak ADMIN_PASSWORD (<16 chars or the placeholder); default: warn only
# ---- Security (see src/security.js) ----
# Production = NODE_ENV=production, or RENDER set (Render sets it), or an https PUBLIC_BASE_URL when NODE_ENV is unset.
# The effective mode is logged at boot ('[mode] ...'). In production, mock/demo behaviour is OFF unless DEMO_MODE=1: unsigned mock Stripe
# webhooks (no STRIPE_SECRET_KEY), Twilio webhooks without TWILIO_AUTH_TOKEN, /pay/mock/*, /billing/mock/*, mock Connect
# onboarding, and mock /api/checkout. Outside production these all work as before.
DEMO_MODE=
# Twilio webhooks are signature-checked whenever TWILIO_AUTH_TOKEN is set (PUBLIC_BASE_URL must equal the URL Twilio
# calls). SKIP_TWILIO_VALIDATION=1 is a local-testing escape hatch and is ignored in production.
SKIP_TWILIO_VALIDATION=
TEXTBACK_COOLDOWN_MINUTES=60   # at most one missed-call text-back per caller number per window; 0 = off
# Text-backs go only to valid US/Canada numbers (anonymous/restricted/international caller IDs are skipped).
OUTBOUND_MAX_PER_HOUR=200      # cap on caller-facing texts per hour (owner alerts excluded); owner alerted once when hit; 0 = off
# Opt-outs: STOP/STOPALL/UNSUBSCRIBE/CANCEL/END/QUIT/OPTOUT/REVOKE and plain-language requests ("stop texting me") are
# stored (db.optOuts) and checked before every send; START/UNSTOP/YES re-subscribe; Twilio error 21610 also opts out.
HELP_MESSAGE=                  # optional custom reply to HELP/INFO
RETENTION_DAYS=                # purge leads (+ message threads) and owner alerts older than N days, at boot and daily; empty/0 = keep
SMS_LOG_BODIES=                # production: 1 = also write SMS bodies to data/sms.log (stdout never has bodies)
AI_REPLY_MAX_CHARS=320         # AI-polished replies longer than this (or adding links/prices/promos) fall back to the template
OPENAI_TIMEOUT_MS=8000
WAITLIST_RATE_MAX=30           # per client IP per FORM_RATE_WINDOW_MINUTES
SETUP_RATE_MAX=20
CHECKOUT_RATE_MAX=30
FORM_RATE_WINDOW_MINUTES=10
MAX_WAITLIST=5000              # waitlist entries kept; new emails beyond this get 503
TRUST_PROXY=                   # Express 'trust proxy' (default 1 hop in production)
CLIENT_IP_HEADER=              # header with the real client IP for rate limits (default true-client-ip only when RENDER is set; none = req.ip)
LOG_FULL_PHONES=               # stdout always masks phone numbers and omits bodies; data/sms.log is masked in production unless this is 1
# Optional: store db.json + sms.log somewhere other than ./data (the demos use this)
DATA_DIR=
# Optional persistence: a Postgres connection string (Render Postgres, Neon, Supabase, ...). When set, db.json and
# the config override are stored in table buzz_kv instead of files, so they survive restarts/redeploys on hosts with
# an ephemeral disk (Render free). Unset = file storage in DATA_DIR. If set but unreachable at boot, falls back to files.
# Non-local hosts use TLS with certificate verification by default (Neon/Render/Supabase have publicly trusted certs).
# DATABASE_SSL=disable turns TLS off; DATABASE_SSL=no-verify keeps TLS but skips cert checks (MITM-able, last resort).
# An explicit sslmode=... in the URL is handled by pg itself (sslmode=require currently also verifies the cert).
DATABASE_URL=
# Shop setup form: owners fill in /setup (saved as 'pending' in db.json setups). An admin clicks
# 'Apply to this line' on /admin, which writes DATA_DIR/config.json. Those values take priority over the
# shop settings above (BUSINESS_*, VERTICAL, phones, hours, SERVICES, booking/deposit, BOOKING_LINK): override > env > default.
