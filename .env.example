PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
BUSINESS_NAME=Peach State Plumbing
# Niche: home_services (default; plumber/HVAC wording, fixed SLOT_MINUTES blocks) | braiders (service menu, $50 deposit)
VERTICAL=home_services
BUSINESS_VERTICAL=plumber   # home_services only: plumber | hvac
# --- braiders only (VERTICAL=braiders) ---
# Service menu "Name:minutes,..." - caller picks one, then gets 3 start times that fit that length in BUSINESS_HOURS
SERVICES=Knotless braids:360,Box braids:300,Locs retwist:120,Twists:180
SLOT_STEP_MINUTES=60       # spacing between offered start times (braiders)
BOOKING_LINK=              # optional: stylist's own Booksy/StyleSeat/GlossGenius link, offered in the texts
# For braiders, unset BUSINESS_HOURS/BUSINESS_DAYS/DEPOSIT_AMOUNT/LEAD_FEE to get defaults 09:00-19:00, Mon-Sat (1-6), $50, $5
OWNER_PHONE=+14045550100
# Twilio (leave blank for demo/log mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Number the Twilio line forwards to (owner's real phone); empty = treat every call as missed
FORWARD_TO_PHONE=
RING_TIMEOUT_SECONDS=20
# AI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Stripe (optional; without STRIPE_SECRET_KEY deposits use a local mock link /pay/mock/:id)
STRIPE_SECRET_KEY=
# Shop subscription billing (src/billing.js). Without STRIPE_SECRET_KEY everything runs in MOCK mode (/billing/mock/*).
# POST /api/checkout {plan: monthly|annual} -> Stripe Checkout mode=subscription, card required, free trial.
STRIPE_PRICE_ID_BASE_MONTHLY=   # recurring monthly Price (e.g. $49/mo)
STRIPE_PRICE_ID_BASE_ANNUAL=    # recurring yearly Price
STRIPE_PRICE_ID_SETUP=          # optional one-time setup Price (~$99); monthly only. Never charged at signup: added as a pending
                                # InvoiceItem on checkout.session.completed so it lands on the first invoice after the trial
FOUNDING_SHOPS_LIMIT=10         # first N shops in the store get the setup fee waived (trial-cancelled shops free their slot)
SETUP_FEE_WAIVED=0              # 1 = waive setup for this deploy's shop(s)
SETUP_WAIVER_CODE=              # optional code: POST /api/checkout {setup_waiver_code} waives setup for that signup
SETUP_FEE_DISPLAY=99            # amount shown in Checkout text / owner reminders (live charge = your Stripe setup Price)
TRIAL_DAYS=14                   # free trial on signup; 0 = no trial. Trial converts automatically unless cancelled
ANNUAL_UPGRADE_PRORATION=always_invoice      # monthly->annual: invoice the prorated difference now
MONTHLY_DOWNGRADE_PRORATION=create_prorations # annual->monthly: unused annual time becomes account credit
BILLING_PORTAL_RETURN_URL=      # where the Stripe Billing Portal returns to; default {PUBLIC_BASE_URL}/
# What happens when the subscription lapses (past_due / canceled / unpaid):
BILLING_ENFORCE=1               # 0 = never limit service for billing reasons
BILLING_REQUIRE_SUBSCRIPTION=0  # 1 = no subscription on file also counts as inactive (0 keeps manual pilots working)
PAST_DUE_GRACE_DAYS=0           # keep full service this many days after a failed payment
INACTIVE_MODE=generic           # generic = caller gets one polite "please call back" text per 24h, no booking/deposit; silent = no text
INACTIVE_MESSAGE=               # optional custom text for generic mode (include "Reply STOP to opt out.")
# Mock-mode demo amounts only (live amounts come from your Stripe Prices)
MOCK_PRICE_MONTHLY=49
MOCK_PRICE_ANNUAL=588
MOCK_SETUP_FEE=99
# Per-paid-lead fee: charged to the shop only when a caller books AND pays the deposit
LEAD_FEE=12                     # USD per paid lead (default 12; braiders default 5)
LEAD_FEE_WAIVED=0               # 1 during the free 14-day pilot: fee recorded as 'waived', nothing charged
# Stripe Connect (optional): shop's connected account (acct_...). Set = deposit Checkout is a destination charge
# (transfer_data.destination = this account, application_fee_amount = LEAD_FEE*100).
# Unset = deposit goes to the platform account and the fee is recorded in bookings (lead_fee_status 'due') for monthly invoicing.
STRIPE_CONNECT_ACCOUNT_ID=
# Booking + deposit (optional; both off = classic name -> need -> callback flow)
BOOKING_ENABLED=1          # offer 3 next open slots after the "need" step; caller replies 1/2/3 or "callback"
BUSINESS_TZ=America/New_York
BUSINESS_HOURS=08:00-17:00 # HH:MM-HH:MM, local to BUSINESS_TZ (default 08:00-17:00; braiders 09:00-19:00)
BUSINESS_DAYS=1,2,3,4,5    # 0=Sun ... 6=Sat (default 1-5; braiders 1,2,3,4,5,6)
SLOT_MINUTES=120           # home_services appointment block length
BOOKING_LEAD_MINUTES=60    # earliest slot must start at least this far from now
DEPOSIT_ENABLED=1          # require a deposit to confirm; off = slot booked immediately
DEPOSIT_AMOUNT=49          # USD (default 49; braiders 50, credited toward the service)
HOLD_MINUTES=30            # unpaid holds expire after this (slot is released)
# Stripe webhook: endpoint {PUBLIC_BASE_URL}/stripe/webhook. Events: checkout.session.completed (deposits + signups),
# customer.subscription.created/updated/deleted, customer.subscription.trial_will_end, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# Admin (also protects /billing/portal, /billing/status, /api/billing/*)
ADMIN_PASSWORD=change-me
# Optional: store db.json + sms.log somewhere other than ./data (the demos use this)
DATA_DIR=
